uses len
int values[4] : {1,,3}
int matrix[2][3] : {{1,2,3},{4}}
char message[5] : "abcdef"

fun <int> = readGlobal() {
    values[1] : 7
    return values[0] + values[1] + values[2] + values[3]
}

fun main() {
    ? values[0], values[1], values[2], values[3]
    ? matrix[0][0], matrix[0][2], matrix[1][0], matrix[1][1]
    ? values.row, values.col, values.dim(0), len(values)
    ? matrix.row, matrix.col, matrix.dim(1)
    ? message
    ? readGlobal()
}
