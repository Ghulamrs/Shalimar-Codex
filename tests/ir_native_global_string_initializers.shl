char first[16] : "Shali"
char second[20] : first + "mar"
char third[24] : second
char fourth[12] : "" + first + "!"
char truncated[6] : second
char fromFunction[24] : makeGreeting()

fun <char[]> = makeGreeting() {
    return second + " Compiler"
}

fun main() {
    ? first
    ? second
    ? third
    ? fourth
    ? truncated
    ? fromFunction
    ? third = second
}
